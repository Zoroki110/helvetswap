.gradle
**/build/
**/bin/
!src/**/build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath


# Covers JetBrains IDEs: IntelliJ, RubyMine, PhpStorm, AppCode, PyCharm, CLion, Android Studio, WebStorm and Rider
# Reference: https://intellij-support.jetbrains.com/hc/en-us/articles/206544839

# User-specific stuff
.idea
.env.local

# daml sdk
.sdk/

# backups
*.bak

# VS Code
.vscode/

# MacOS
.DS_Store

# direnv
.direnv/

# --- Ajouts pour la copie publique ---
# Node / React
node_modules/
playwright-report/
test-results/
# Daml (artefacts de build ; les DAR de dépendance versionnés dans quickstart/daml/dars restent suivis)
.daml/
# Java
*.class
# Environnement et secrets
.env
.env.*
!.env.example
*.pem
*.p12
*.jks
# Journaux
*.log